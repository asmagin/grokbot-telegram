{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/healthz", "destination": "/api?path=/healthz" },
    { "source": "/webhook", "destination": "/api?path=/webhook" },
    { "source": "/send", "destination": "/api?path=/send" },
    { "source": "/send/media", "destination": "/api?path=/send/media" },
    { "source": "/file/:token", "destination": "/api?path=/file/:token" },
    { "source": "/typing/stop", "destination": "/api?path=/typing/stop" },
    { "source": "/typing/heartbeat", "destination": "/api?path=/typing/heartbeat" }
  ]
}
