# An empty KEY= line is still a value.

# Telegram bot token from @BotFather. The bridge holds it.
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token

# Secret you generate and pass to setWebhook as secret_token.
# 16-256 chars of A-Z a-z 0-9 _ - (Telegram's charset). openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-random-hex

# Bot username, @ removed. Required for group @mentions, /commands@bot, and reply detection.
TELEGRAM_BOT_USERNAME=your_bot_username

# Optional numeric bot id from getMe. Improves "reply to the bot" detection.
TELEGRAM_BOT_ID=

# Grok Bot routine webhook URL and the sender key from that routine's panel.
GROK_WEBHOOK_URL=https://example.com/webhook/replace-me
GROK_WEBHOOK_SENDER_KEY=replace-with-routine-sender-key

# HMAC secret for per-wake reply tokens. At least 32 chars, unique per bridge.
# openssl rand -hex 32
REPLY_TOKEN_SECRET=replace-with-another-random-hex

# Public https origin of this bridge, trailing slash removed (http for localhost).
# The bridge builds reply links in the wake payload from this alone.
PUBLIC_BASE_URL=https://your-bridge.example

# Optional mount prefix. Leave empty on Cloudflare, Vercel, and Node.
PATH_PREFIX=

# Comma-separated. Set at least one. With both empty, the bridge denies everyone.
# USER_IDS admit that person's DMs and their messages in any chat.
# CHAT_IDS admit everyone in that chat.
ALLOWLIST_USER_IDS=
ALLOWLIST_CHAT_IDS=

# Group slash commands that wake the bot, in addition to @mentions and replies.
WAKE_COMMANDS=/ask,/help

# Optional long-lived key for proactive sends to allowlisted chats. At least 32 chars.
# Set it only for sends outside a wake.
OUTBOUND_API_KEY=

# Feature flags. Default off.
BRIDGE_ACK=false
FAST_GREETING=false
ALLOW_INSECURE_WEBHOOK=false
# Experimental: sendMessageDraft "Thinking…" placeholder, private chats only.
TELEGRAM_DRAFT_PLACEHOLDER=false

# Progress feedback. Empty means the default.
# Reaction set on the user's message while the bot works: an emoji from the
# Bot API ReactionTypeEmoji list (default 👀), or "off".
PROGRESS_REACTION=
# One silent line when Grok Bot rejects a wake, or "off". Max 500 chars.
# Default: Sorry — I couldn't pick that up just now. Mind sending it again?
FORWARD_FAILURE_TEXT=

# Tuning. Defaults shown.
# Reply token lifetime, 60-3600. Also caps how long typing and the reaction can last.
REPLY_TOKEN_TTL_SECONDS=1800
# Typing refresh, 1000-4500. Telegram shows typing for 5 seconds or less.
TYPING_REFRESH_MS=3000
# Per-wake lease, renewed by each progress line or heartbeat. 60000-3600000.
TYPING_LEASE_MS=600000
# Hard ceiling per wake from its start. 60000-7200000.
TYPING_MAX_MS=1800000
CONTEXT_LIMIT=10
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_BYTES=1000000
# Multipart upload cap for POST /send/media. Default 4000000, hard cap 4194304.
# Larger photos and documents use an https url. Telegram downloads it.
MAX_MEDIA_BYTES=4000000
DEDUPE_TTL_MS=86400000
# How long to wait after a forward so a comment sent right after it joins the
# same wake. 0 wakes on each update immediately. Clamped to 0-5000.
FORWARD_BURST_MS=1500

# Inbound speech-to-text. Leave the key empty to keep wake attachments unchanged.
# When set, the bridge sends allowlisted voice notes, short audio, and video notes
# to OpenAI (model gpt-transcribe) and adds transcript fields to those attachments.
# Create the key at https://platform.openai.com/api-keys and add it on the host
# (Vercel: Project Settings, Environment Variables) as OPENAI_API_KEY.
OPENAI_API_KEY=
# Used only when OPENAI_API_KEY is set. Duration is 1-180 seconds, default 60.
# Bytes are 1024-4000000, default 2000000. Over either cap, the wake has no
# transcript and transcript_error is too_long or too_large. The file URL remains.
TRANSCRIBE_MAX_SECONDS=60
TRANSCRIBE_MAX_BYTES=2000000
